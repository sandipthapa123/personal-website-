datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

// ----------------------------------------------------
// 1. TENANT & PLATFORM SYSTEM
// ----------------------------------------------------

model Tenant {
  id         String   @id @default(uuid())
  slug       String   @unique
  domain     String   @unique
  name       String
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  settings          TenantSetting[]
  tokens            DesignToken[]
  pages             Page[]
  menus             NavigationMenu[]
  media             MediaFile[]
  blocks            Block[]
  workflows         WorkflowDefinition[]
  universal_content UniversalContent[]
}

model TenantSetting {
  id        String @id @default(uuid())
  tenant_id String
  category  String // site, theme, seo, security, accessibility, analytics, storage
  key       String
  value     String
  tenant    Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, category, key])
}

model FeatureFlag {
  id          String   @id @default(uuid())
  tenant_id   String?
  key         String   @unique
  name        String
  description String?
  is_enabled  Boolean  @default(false)
  rules_json  String?
  updated_at  DateTime @updatedAt
}

// ----------------------------------------------------
// 2. AUTH, ROLES & POLICY-DRIVEN PERMISSIONS
// ----------------------------------------------------

model User {
  id                    String    @id @default(uuid())
  email                 String    @unique
  password_hash         String
  first_name            String
  last_name             String
  avatar_url            String?
  status                String    @default("ACTIVE")
  totp_secret           String?
  totp_enabled          Boolean   @default(false)
  failed_login_attempts Int       @default(0)
  locked_until          DateTime?
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt

  user_roles       UserRole[]
  audit_logs       AuditLog[]
  sessions         Session[]
  content_authored UniversalContentAuthor[]
  auth_tokens      AuthToken[]
  recovery_codes   RecoveryCode[]
}

model AuthToken {
  id         String    @id @default(uuid())
  user_id    String
  token_hash String    @unique
  purpose    String // 'PASSWORD_RESET' | 'INVITE' | 'EMAIL_CHANGE'
  metadata   String? // JSON, e.g. { "newEmail": "..." } for EMAIL_CHANGE
  expires_at DateTime
  used_at    DateTime?
  created_at DateTime  @default(now())
  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, purpose])
}

model RecoveryCode {
  id         String    @id @default(uuid())
  user_id    String
  code_hash  String
  used_at    DateTime?
  created_at DateTime  @default(now())
  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

model Role {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?
  is_system   Boolean @default(false)

  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id          String  @id @default(uuid())
  action      String  @unique // e.g. pages:publish, media:upload
  module      String
  description String?

  roles    RolePermission[]
  policies Policy[]
}

model RolePermission {
  role_id       String
  permission_id String
  role          Role       @relation(fields: [role_id], references: [id], onDelete: Cascade)
  permission    Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@id([role_id, permission_id])
}

model Policy {
  id            String     @id @default(uuid())
  permission_id String
  name          String
  condition     String
  permission    Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade)
}

model UserRole {
  user_id String
  role_id String
  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  role    Role   @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@id([user_id, role_id])
}

model Session {
  id            String    @id @default(uuid())
  user_id       String
  token_hash    String    @unique // sha256 hash of the live credential (admin session cookie or API access token) identifying this session
  user_agent    String?
  ip_address    String?
  expires_at    DateTime
  revoked_at    DateTime?
  created_at    DateTime  @default(now())
  user          User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model AuditLog {
  id          String   @id @default(uuid())
  tenant_id   String?
  user_id     String?
  action      String
  entity_type String
  entity_id   String?
  payload     String?
  ip_address  String?
  created_at  DateTime @default(now())
  user        User?    @relation(fields: [user_id], references: [id], onDelete: SetNull)
}

// ----------------------------------------------------
// 3. DESIGN TOKENS ENGINE
// ----------------------------------------------------

model DesignToken {
  id          String  @id @default(uuid())
  tenant_id   String
  category    String // colors, typography, spacing, radius, elevation
  token_name  String // e.g. color-primary-500
  token_value String
  dark_value  String?
  unit        String?
  tenant      Tenant  @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, category, token_name])
}

// ----------------------------------------------------
// 4. WORKFLOW ORCHESTRATOR ENGINE
// ----------------------------------------------------

model WorkflowDefinition {
  id          String @id @default(uuid())
  tenant_id   String
  entity_type String // page, blog_post, block
  name        String
  states_json String // State machine states & transition rules
  tenant      Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
}

// ----------------------------------------------------
// 5. LAYOUTS, REGIONS, BLOCKS & PAGES
// ----------------------------------------------------

model Layout {
  id      String   @id @default(uuid())
  name    String   @unique
  slug    String   @unique
  regions Region[]
  pages   Page[]
}

model Region {
  id        String @id @default(uuid())
  layout_id String
  key       String // header, sidebar, main, footer
  name      String
  layout    Layout @relation(fields: [layout_id], references: [id], onDelete: Cascade)

  page_blocks PageRegionBlock[]
}

model BlockDefinition {
  id              String  @id @default(uuid())
  type            String  @unique
  name            String
  category        String
  prop_schema     String
  default_props   String
  allowed_regions String
  blocks          Block[]
}

model Block {
  id                  String    @id @default(uuid())
  tenant_id           String
  block_definition_id String
  name                String
  json_config         String
  style_config        String?
  visibility_config   String?
  permission_rules    String?
  animations_config   String?
  responsive_config   String?
  status              String    @default("DRAFT")
  version             Int       @default(1)
  deleted_at          DateTime?
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  tenant          Tenant            @relation(fields: [tenant_id], references: [id])
  definition      BlockDefinition   @relation(fields: [block_definition_id], references: [id])
  versions        BlockVersion[]
  page_placements PageRegionBlock[]
}

model BlockVersion {
  id           String   @id @default(uuid())
  block_id     String
  version      Int
  json_config  String
  style_config String?
  created_by   String?
  created_at   DateTime @default(now())
  block        Block    @relation(fields: [block_id], references: [id], onDelete: Cascade)
}

model Page {
  id           String    @id @default(uuid())
  tenant_id    String
  layout_id    String
  slug         String
  title        String
  locale       String    @default("en")
  status       String    @default("DRAFT")
  version      Int       @default(1)
  scheduled_at DateTime?
  published_at DateTime?
  seo_metadata String?
  deleted_at   DateTime?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  tenant        Tenant            @relation(fields: [tenant_id], references: [id])
  layout        Layout            @relation(fields: [layout_id], references: [id])
  versions      PageVersion[]
  region_blocks PageRegionBlock[]

  @@unique([tenant_id, slug, locale])
  @@index([slug])
}

model PageVersion {
  id          String   @id @default(uuid())
  page_id     String
  version     Int
  layout_json String
  created_by  String?
  created_at  DateTime @default(now())
  page        Page     @relation(fields: [page_id], references: [id], onDelete: Cascade)
}

model PageRegionBlock {
  id        String @id @default(uuid())
  page_id   String
  region_id String
  block_id  String
  order     Int

  page   Page   @relation(fields: [page_id], references: [id], onDelete: Cascade)
  region Region @relation(fields: [region_id], references: [id], onDelete: Cascade)
  block  Block  @relation(fields: [block_id], references: [id], onDelete: Cascade)
}

// ----------------------------------------------------
// 6. NAVIGATION & MEDIA
// ----------------------------------------------------

model NavigationMenu {
  id        String               @id @default(uuid())
  tenant_id String
  location  String
  name      String
  tenant    Tenant               @relation(fields: [tenant_id], references: [id])
  items     NavigationMenuItem[]
}

model NavigationMenuItem {
  id         String               @id @default(uuid())
  menu_id    String
  parent_id  String?
  label      String
  url        String
  icon       String?
  target     String               @default("_self")
  order      Int
  visibility String?
  menu       NavigationMenu       @relation(fields: [menu_id], references: [id], onDelete: Cascade)
  parent     NavigationMenuItem?  @relation("MenuHierarchy", fields: [parent_id], references: [id])
  children   NavigationMenuItem[] @relation("MenuHierarchy")
}

model MediaFile {
  id            String   @id @default(uuid())
  tenant_id     String
  filename      String
  original_name String
  mime_type     String
  size_bytes    BigInt
  storage_key   String   @unique
  folder        String   @default("/")
  dimensions    String?
  variants_json String?
  alt_text      String?
  caption       String?
  created_at    DateTime @default(now())

  tenant         Tenant         @relation(fields: [tenant_id], references: [id])
  content_usages ContentMedia[]
}

// ----------------------------------------------------
// 7. UNIVERSAL CONTENT ENGINE (SINGLE SOURCE OF TRUTH)
// ----------------------------------------------------

model UniversalContent {
  id                   String  @id @default(uuid())
  tenant_id            String
  slug                 String  @unique
  slug_mode            String  @default("AUTO")
  title                String
  summary              String?
  content              String
  cover_image          String?
  content_type         String // 'Article', 'Research', 'Publication', 'Event', 'Poem', 'Project', etc.
  locale               String  @default("en")
  translation_group_id String? // Links Nepali and English versions of same content
  status               String  @default("DRAFT")
  visibility           String  @default("PUBLIC")
  password             String?
  is_sticky            Boolean @default(false)
  allow_comments       Boolean @default(true)
  post_format          String  @default("standard")
  views                Int     @default(0)
  word_count           Int     @default(0)
  reading_time         Int     @default(1)

  seo_metadata         String? // metaTitle, metaDescription, canonicalUrl, ogImage, jsonLd
  custom_fields        String? // citations, DOIs, event dates, pdfUrl, partners, externalLinks, timeline
  accessibility_status String? // score, wcagLevel, compliant

  version      Int       @default(1)
  published_at DateTime?
  scheduled_at DateTime?
  deleted_at   DateTime?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  tenant     Tenant                   @relation(fields: [tenant_id], references: [id])
  categories ContentCategory[]
  tags       ContentTag[]
  topics     ContentTopic[]
  authors    UniversalContentAuthor[]
  media      ContentMedia[]
  revisions  ContentRevision[]

  // Self-referential related content
  related_to   ContentRelation[] @relation("SourceContent")
  related_from ContentRelation[] @relation("TargetContent")

  @@index([status])
  @@index([content_type])
  @@index([locale])
  @@index([published_at])
}

model Category {
  id              String   @id @default(uuid())
  name            String   @unique
  slug            String   @unique
  description     String?
  parent_id       String?
  display_order   Int      @default(0)
  icon            String?
  status          String   @default("ACTIVE")
  seo_title       String?
  seo_description String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  parent   Category?         @relation("CategoryHierarchy", fields: [parent_id], references: [id])
  children Category[]        @relation("CategoryHierarchy")
  content  ContentCategory[]
}

model Tag {
  id      String       @id @default(uuid())
  name    String       @unique
  slug    String       @unique
  content ContentTag[]
}

model Topic {
  id      String         @id @default(uuid())
  name    String         @unique
  slug    String         @unique
  content ContentTopic[]
}

// Join tables for Content Relationships
model ContentCategory {
  content_id  String
  category_id String
  is_primary  Boolean          @default(false)
  content     UniversalContent @relation(fields: [content_id], references: [id], onDelete: Cascade)
  category    Category         @relation(fields: [category_id], references: [id], onDelete: Cascade)

  @@id([content_id, category_id])
}

model ContentTag {
  content_id String
  tag_id     String
  content    UniversalContent @relation(fields: [content_id], references: [id], onDelete: Cascade)
  tag        Tag              @relation(fields: [tag_id], references: [id], onDelete: Cascade)

  @@id([content_id, tag_id])
}

model ContentTopic {
  content_id String
  topic_id   String
  content    UniversalContent @relation(fields: [content_id], references: [id], onDelete: Cascade)
  topic      Topic            @relation(fields: [topic_id], references: [id], onDelete: Cascade)

  @@id([content_id, topic_id])
}

model UniversalContentAuthor {
  content_id String
  user_id    String
  order      Int              @default(0)
  content    UniversalContent @relation(fields: [content_id], references: [id], onDelete: Cascade)
  user       User             @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([content_id, user_id])
}

model ContentMedia {
  content_id String
  media_id   String
  usage_type String           @default("gallery") // featured, gallery, document
  order      Int              @default(0)
  content    UniversalContent @relation(fields: [content_id], references: [id], onDelete: Cascade)
  media      MediaFile        @relation(fields: [media_id], references: [id], onDelete: Cascade)

  @@id([content_id, media_id, usage_type])
}

model ContentRelation {
  source_id     String
  target_id     String
  relation_type String           @default("related") // related, citation, prerequisite, part_of
  order         Int              @default(0)
  source        UniversalContent @relation("SourceContent", fields: [source_id], references: [id], onDelete: Cascade)
  target        UniversalContent @relation("TargetContent", fields: [target_id], references: [id], onDelete: Cascade)

  @@id([source_id, target_id])
}

model ContentRevision {
  id            String           @id @default(uuid())
  content_id    String
  version       Int
  title         String
  content       String
  snapshot_json String
  created_by    String?
  created_at    DateTime         @default(now())
  content_ref   UniversalContent @relation(fields: [content_id], references: [id], onDelete: Cascade)
}

// ----------------------------------------------------
// 8. CONTACT & INQUIRY TICKETS
// ----------------------------------------------------

model ContactTicket {
  id         String   @id @default(uuid())
  name       String
  email      String
  subject    String?
  message    String
  status     String   @default("NEW")
  metadata   String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  replies TicketMessage[]
}

model TicketMessage {
  id         String        @id @default(uuid())
  ticket_id  String
  sender     String // 'USER' | 'ADMIN'
  message    String
  created_at DateTime      @default(now())
  ticket     ContactTicket @relation(fields: [ticket_id], references: [id], onDelete: Cascade)
}

// ----------------------------------------------------
// 9. NEWSLETTER SYSTEM
// ----------------------------------------------------

model NewsletterSubscriber {
  id            String   @id @default(uuid())
  email         String   @unique
  first_name    String?
  last_name     String?
  status        String   @default("SUBSCRIBED")
  metadata      String?
  subscribed_at DateTime @default(now())
  updated_at    DateTime @updatedAt
}

model NewsletterCampaign {
  id           String    @id @default(uuid())
  subject      String
  html_content String
  status       String    @default("DRAFT") // DRAFT, SCHEDULED, SENDING, SENT, FAILED
  recipients   Int       @default(0)
  scheduled_at DateTime?
  sent_at      DateTime?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt
}

// ----------------------------------------------------
// 10. PLUGINS, ANALYTICS & SEARCH INDEX
// ----------------------------------------------------

model Plugin {
  id           String   @id @default(uuid())
  name         String   @unique
  version      String
  is_active    Boolean  @default(false)
  config_json  String?
  installed_at DateTime @default(now())
}

model AnalyticsEvent {
  id         String   @id @default(uuid())
  tenant_id  String?
  event_type String // page_view, search, download, click
  path       String
  referrer   String?
  query      String?
  ip_hash    String?
  user_agent String?
  country    String?
  city       String?
  timestamp  DateTime @default(now())
}

model SearchIndex {
  id          String   @id @default(uuid())
  tenant_id   String?
  entity_type String
  entity_id   String
  title       String
  content     String
  locale      String   @default("en")
  url         String
  updated_at  DateTime @updatedAt

  @@unique([entity_type, entity_id])
}
