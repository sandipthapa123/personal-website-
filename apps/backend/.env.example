PORT=4000
NODE_ENV=development
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cms_db?schema=public"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="super-secret-jwt-key-thapasandip-cms"
JWT_REFRESH_SECRET="super-secret-refresh-key-thapasandip-cms"
CORS_ORIGINS="http://localhost:3000,http://localhost:4000"

####################################################
# EMAIL (Single Source of Truth)
####################################################

MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_REQUIRE_TLS=true

MAIL_USER=user@example.com
MAIL_PASS=changeme

MAIL_FROM_NAME="Your Name"
MAIL_FROM_EMAIL=user@example.com

####################################################
# DEFAULT EMAILS
####################################################

ADMIN_EMAIL=user@example.com
SUPPORT_EMAIL=user@example.com
NOREPLY_EMAIL=user@example.com

####################################################
# APPLICATION
####################################################

APP_NAME="Sandip Thapa CMS Platform"
APP_URL=http://localhost:4000

